; Controlador: importa archivos completos y reproduce sus filas. No simula contagios.
to startup
  clear-all
  set datos-java []
  set datos-referencia []
  set indice 0
  set estado-mensaje "Abre un CSV generado por Java."
  if file-exists? "datos/resultados_java.csv" [ cargar-java-desde "datos/resultados_java.csv" ]
end

to cargar-java-desde [ruta]
  ; Solo se sustituye el escenario despues de validar todo el archivo.
  let nuevos leer-serie ruta
  set datos-java nuevos
  set nombre-java ruta
  set indice 0
  actualizar-vista
  set estado-mensaje (word "Escenario A: " ruta " | listo en t=0")
end

to cargar-referencia-desde [ruta]
  let nuevos leer-serie ruta
  set datos-referencia nuevos
  set nombre-referencia ruta
  set indice 0
  actualizar-vista
  set estado-mensaje "Escenario B cargado: otra ejecucion Java. Compara A y B con los mismos ejes."
end

to elegir-java
  let ruta user-file
  if ruta != false [
    carefully [ cargar-java-desde ruta ] [ set estado-mensaje (word "No se cargo: " error-message) ]
  ]
end

to elegir-referencia
  let ruta user-file
  if ruta != false [
    carefully [ cargar-referencia-desde ruta ] [ set estado-mensaje (word "No se cargo: " error-message) ]
  ]
end

to quitar-referencia
  set datos-referencia []
  set nombre-referencia ""
  set indice min (list indice (max (list 0 (length datos-java - 1))))
  actualizar-vista
  set estado-mensaje "Comparacion retirada; Escenario A conservado."
end

to reiniciar
  set indice 0
  actualizar-vista
  set estado-mensaje "t=0. Continuar reproduce el CSV; no genera datos."
end

to avanzar
  if empty? datos-java [ set estado-mensaje "Abre primero un CSV Java." stop ]
  if terminado? [ set estado-mensaje "Fin del CSV. Reinicia para volver a reproducir." stop ]
  set indice indice + 1
  agregar-fila indice
  set estado-mensaje (word "Reproduciendo t=" indice " de " ultimo-indice ". Todos los puntos vienen de Java.")
  display
end

to animar
  if empty? datos-java [ set estado-mensaje "Abre primero un CSV Java." stop ]
  if terminado? [ stop ]
  avanzar
  wait 0.10
end

to mostrar-completo
  set indice ultimo-indice
  actualizar-vista
  set estado-mensaje "Vista completa. Reiniciar vuelve a t=0."
end

to-report ultimo-indice
  report max (list 0 (length datos-java - 1) (length datos-referencia - 1))
end

to-report terminado?
  report indice >= ultimo-indice
end
