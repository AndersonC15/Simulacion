    <button x="737" y="80" width="145" height="38" forever="false" kind="Observer" disableUntilTicks="false" display="REINICIAR">reiniciar</button>
    <button x="890" y="80" width="145" height="38" forever="true" kind="Observer" disableUntilTicks="false" display="ANIMAR">avanzar</button>
    <button x="1043" y="80" width="170" height="38" forever="false" kind="Observer" disableUntilTicks="false" display="VER COMPLETO">mostrar-completo</button>
    <button x="15" y="126" width="225" height="38" forever="false" kind="Observer" disableUntilTicks="false" display="EXPORTAR INTERFAZ PNG">exportar-interfaz</button>
    <note x="255" y="127" width="955" height="40" fontSize="11" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0" markdown="false">Referencia opcional: segunda ejecucion de Java (ejemplo: semilla 7). No hay simulador SIR en NetLogo.
Para reproducir: REINICIAR y ANIMAR. Deten ANIMAR antes de cargar otro archivo.</note>
