<?xml version='1.0' encoding='utf-8'?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code>extensions [csv]
__includes ["datos.nls" "vista.nls" "controlador.nls"]
globals [poblacion-total tiempo-maximo datos-java datos-referencia indice estado-mensaje]
</code>
  <widgets>
    <note x="15" y="5" width="1200" height="38" fontSize="22" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0" markdown="false">APE 04 | Java genera los datos - NetLogo los representa</note>
    <note x="15" y="46" width="1200" height="26" fontSize="12" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0" markdown="false">SIR: N=100 | S0=95 | I0=5 | beta=0.30 | gamma=0.10 | 100 pasos | CSV principal: java_simulado.csv</note>
    <button x="15" y="80" width="155" height="38" forever="false" kind="Observer" disableUntilTicks="false" display="CARGAR JAVA">cargar-java</button>
    <button x="178" y="80" width="165" height="38" forever="false" kind="Observer" disableUntilTicks="false" display="OTRO PRINCIPAL">elegir-java</button>
    <button x="351" y="80" width="190" height="38" forever="false" kind="Observer" disableUntilTicks="false" display="CARGAR REFERENCIA">cargar-referencia</button>
