<?xml version='1.0' encoding='utf-8'?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code>extensions [csv]
__includes ["datos.nls" "vista.nls" "controlador.nls"]
globals [datos-java datos-referencia nombre-java nombre-referencia indice estado-mensaje]
</code>
  <widgets>
    <button x="12" y="8" width="218" height="34" forever="false" kind="Observer" disableUntilTicks="false" display="ABRIR CSV">elegir-java</button>
    <button x="242" y="8" width="218" height="34" forever="false" kind="Observer" disableUntilTicks="false" display="COMPARAR CSV">elegir-referencia</button>
    <button x="472" y="8" width="218" height="34" forever="false" kind="Observer" disableUntilTicks="false" display="REINICIAR">reiniciar</button>
    <button x="702" y="8" width="218" height="34" forever="true" kind="Observer" disableUntilTicks="false" display="ANIMAR / PAUSAR">animar</button>
    <button x="932" y="8" width="218" height="34" forever="false" kind="Observer" disableUntilTicks="false" display="VER COMPLETO">mostrar-completo</button>
    <monitor x="12" y="50" width="136" height="48" precision="0" fontSize="11" display="t A">valor-java 0</monitor>
    <monitor x="156" y="50" width="136" height="48" precision="0" fontSize="11" display="S A">valor-java 1</monitor>
    <monitor x="300" y="50" width="136" height="48" precision="0" fontSize="11" display="I A">valor-java 2</monitor>
    <monitor x="444" y="50" width="136" height="48" precision="0" fontSize="11" display="R A">valor-java 3</monitor>
    <monitor x="588" y="50" width="136" height="48" precision="0" fontSize="11" display="t B">valor-referencia 0</monitor>
    <monitor x="732" y="50" width="136" height="48" precision="0" fontSize="11" display="S B">valor-referencia 1</monitor>
    <monitor x="876" y="50" width="136" height="48" precision="0" fontSize="11" display="I B">valor-referencia 2</monitor>
    <monitor x="1020" y="50" width="136" height="48" precision="0" fontSize="11" display="R B">valor-referencia 3</monitor>
    <plot x="12" y="106" width="570" height="210" xMin="0" xMax="100" yMin="0" yMax="100" autoPlotX="false" autoPlotY="false" legend="true" display="Escenario A" xAxis="Tiempo (pasos)" yAxis="Personas" sizeVersion="1">
      <setup />
      <update />
      <pen display="S" interval="1.0" mode="0" color="-16733363" legend="true">
        <setup />
        <update />
      </pen>
      <pen display="I" interval="1.0" mode="0" color="-16051680" legend="true">
        <setup />
        <update />
      </pen>
      <pen display="R" interval="1.0" mode="0" color="-8217968" legend="true">
        <setup />
        <update />
      </pen>
    </plot>
    <plot x="594" y="106" width="570" height="210" xMin="0" xMax="100" yMin="0" yMax="100" autoPlotX="false" autoPlotY="false" legend="true" display="Escenario B" xAxis="Tiempo (pasos)" yAxis="Personas" sizeVersion="1">
      <setup />
      <update />
      <pen display="S" interval="1.0" mode="0" color="-16733363" legend="true">
        <setup />
        <update />
      </pen>
      <pen display="I" interval="1.0" mode="0" color="-16051680" legend="true">
        <setup />
        <update />
      </pen>
      <pen display="R" interval="1.0" mode="0" color="-8217968" legend="true">
        <setup />
        <update />
      </pen>
    </plot>
    <plot x="12" y="326" width="376" height="180" xMin="0" xMax="100" yMin="0" yMax="100" autoPlotX="false" autoPlotY="false" legend="true" display="Susceptibles: A / B" xAxis="Tiempo (pasos)" yAxis="Personas" sizeVersion="1">
      <setup />
      <update />
      <pen display="A" interval="1.0" mode="0" color="-16733363" legend="true">
        <setup />
        <update />
      </pen>
      <pen display="B" interval="1.0" mode="0" color="-16051680" legend="true">
        <setup />
        <update />
      </pen>
    </plot>
    <plot x="400" y="326" width="376" height="180" xMin="0" xMax="100" yMin="0" yMax="100" autoPlotX="false" autoPlotY="false" legend="true" display="Infectados: A / B" xAxis="Tiempo (pasos)" yAxis="Personas" sizeVersion="1">
      <setup />
      <update />
      <pen display="A" interval="1.0" mode="0" color="-16733363" legend="true">
        <setup />
        <update />
      </pen>
      <pen display="B" interval="1.0" mode="0" color="-16051680" legend="true">
        <setup />
        <update />
      </pen>
    </plot>
    <plot x="788" y="326" width="376" height="180" xMin="0" xMax="100" yMin="0" yMax="100" autoPlotX="false" autoPlotY="false" legend="true" display="Recuperados: A / B" xAxis="Tiempo (pasos)" yAxis="Personas" sizeVersion="1">
      <setup />
      <update />
      <pen display="A" interval="1.0" mode="0" color="-16733363" legend="true">
        <setup />
        <update />
      </pen>
      <pen display="B" interval="1.0" mode="0" color="-16051680" legend="true">
        <setup />
        <update />
      </pen>
    </plot>
    <monitor x="12" y="516" width="1152" height="48" precision="0" fontSize="11" display="Estado">estado-mensaje</monitor>
    <view x="12" y="570" width="1" height="1" minPxcor="0" maxPxcor="0" minPycor="0" maxPycor="0" patchSize="1" wrappingAllowedX="false" wrappingAllowedY="false" fontSize="10" updateMode="0" showTickCounter="false" frameRate="30" />
  </widgets>
  <info>Java calcula el SIR. NetLogo valida e importa los CSV y representa sus filas. A y B son dos ejecuciones Java. Abrir el visor con java -jar sir.jar evita las pestanas del editor NetLogo.</info>
  <turtleShapes>
    <shape name="default" rotatable="true" editableColorIndex="0">
      <circle color="-7500403" filled="true" marked="true" x="0" y="0" diameter="300" />
    </shape>
  </turtleShapes>
  <previewCommands>startup</previewCommands>
</model>