; Contrato CSV: enteros, tiempo consecutivo, poblacion constante y transiciones SIR.
to-report leer-serie [ruta]
  if not file-exists? ruta [ error "No existe el CSV seleccionado." ]
  let serie []
  carefully [
    file-open ruta
    if file-at-end? [ error "El CSV esta vacio." ]
    let cabecera leer-linea-limitada
    if not empty? cabecera [ if (substring cabecera 0 1) = "﻿" [ set cabecera substring cabecera 1 (length cabecera) ] ]
    if cabecera = "tiempo,id,estado" [ error "Seleccionaste el detalle individual. Abre el CSV agregado de la misma ejecucion." ]
    if cabecera != "tiempo,susceptibles,infectados,recuperados" [ error "Encabezado CSV agregado incorrecto." ]
    let cantidad-caracteres length cabecera
    while [not file-at-end?] [
      let linea leer-linea-limitada
      set cantidad-caracteres cantidad-caracteres + length linea
      if length linea > 256 or cantidad-caracteres > 1048576 or length serie >= 2001 [ error "CSV demasiado grande." ]
      let fila csv:from-row linea
      if length fila != 4 [ error "Cada fila debe tener cuatro columnas." ]
      foreach fila [valor ->
        if not is-number? valor [ error "Solo se aceptan numeros enteros." ]
        if valor < 0 or valor > 10000 or valor != floor valor [ error "Conteos/tiempo fuera de rango." ]
      ]
      if item 0 fila != length serie [ error "Tiempo discontinuo: debe comenzar en cero." ]
      if item 0 fila > 2000 [ error "Maximo 2000 pasos." ]
      let total sum but-first fila
      if total < 1 or total > 10000 [ error "N debe estar entre 1 y 10000." ]
      ifelse empty? serie [
        if item 3 fila != 0 [ error "El escenario Java comienza con R=0." ]
      ] [
        let previo last serie
        if total != sum but-first previo [ error "No se conserva S+I+R." ]
        if item 1 fila > item 1 previo or item 3 fila < item 3 previo [ error "S aumenta o R disminuye." ]
        if (item 3 fila - item 3 previo) > item 2 previo [ error "Se recuperan mas personas que los infectados previos." ]
        if item 2 previo = 0 and item 1 fila != item 1 previo [ error "Contagios sin infectados: transicion imposible." ]
      ]
      set serie lput fila serie
    ]
    file-close
  ] [
    let detalle error-message
    file-close-all
    error detalle
  ]
  if empty? serie [ error "El CSV no tiene registros." ]
  report serie
end

to-report leer-linea-limitada
  let linea ""
  while [not file-at-end?] [
    let caracter file-read-characters 1
    if caracter = "\n" [
      if not empty? linea [ if last linea = "\r" [ set linea but-last linea ] ]
      report linea
    ]
    set linea word linea caracter
    if length linea > 256 [ error "Una linea del CSV excede 256 caracteres." ]
  ]
  if not empty? linea [ if last linea = "\r" [ set linea but-last linea ] ]
  report linea
end
