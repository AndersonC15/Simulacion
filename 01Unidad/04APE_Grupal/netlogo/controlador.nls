; Controlador: importa y valida antes de sustituir la ejecucion visible. No simula contagios.
to startup
  file-close-all
  clear-all
  set datos-java []
  set datos-referencia []
  set archivo-individual-java ""
  set archivo-individual-referencia ""
  set paso-individual-java -1
  set paso-individual-referencia -1
  set indice 0
  set estado-mensaje "Abre un CSV agregado generado por Java."
  actualizar-vista
  if file-exists? "datos/resultados_java.csv" [
    carefully [ cargar-java-desde "datos/resultados_java.csv" ]
      [ set estado-mensaje (word "No se cargo el ejemplo inicial: " error-message ". Abre otro CSV agregado.") ]
  ]
end

to cargar-java-desde [ruta]
  cerrar-lecturas
  let nuevos leer-serie ruta
  let detalle validar-individuos ruta nuevos
  set datos-java nuevos
  set archivo-individual-java detalle
  set nombre-java ruta
  set indice 0
  actualizar-vista
  set estado-mensaje (word "Escenario A listo en t=0. " ifelse-value (detalle = "") ["Sin detalle individual: solo graficas."] ["Personas reales de Java."])
end

to cargar-referencia-desde [ruta]
  cerrar-lecturas
  let nuevos leer-serie ruta
  let detalle validar-individuos ruta nuevos
  set datos-referencia nuevos
  set archivo-individual-referencia detalle
  set nombre-referencia ruta
  set indice 0
  actualizar-vista
  set estado-mensaje (word "Escenario B cargado. " ifelse-value (detalle = "") ["Sin detalle individual: solo graficas."] ["Personas reales de Java."])
end

to elegir-java
  let ruta user-file
  if ruta != false [ carefully [ cargar-java-desde ruta ] [ set estado-mensaje (word "No se cargo: " error-message) ] ]
end

to elegir-referencia
  let ruta user-file
  if ruta != false [ carefully [ cargar-referencia-desde ruta ] [ set estado-mensaje (word "No se cargo: " error-message) ] ]
end

to quitar-referencia
  cerrar-lecturas
  set datos-referencia []
  set archivo-individual-referencia ""
  set nombre-referencia ""
  set indice min (list indice (max (list 0 (length datos-java - 1))))
  actualizar-vista
  set estado-mensaje "Comparacion retirada; Escenario A conservado."
end

to reiniciar
  set indice 0
  actualizar-vista
  set estado-mensaje "t=0. Continuar reproduce los CSV; no genera datos."
end

to avanzar
  if empty? datos-java [ set estado-mensaje "Abre primero un CSV Java." stop ]
  if terminado? [ set estado-mensaje "Fin del CSV. Reinicia para volver a reproducir." stop ]
  set indice indice + 1
  agregar-fila indice
  actualizar-personas
  set estado-mensaje (word "Reproduciendo t=" indice " de " ultimo-indice ". Curvas y personas vienen de Java.")
  display
end

to animar
  if empty? datos-java [ set estado-mensaje "Abre primero un CSV Java." stop ]
  if terminado? [ stop ]
  avanzar
  wait 0.10
end

to mostrar-completo
  set indice ultimo-indice
  actualizar-vista
  set estado-mensaje "Vista completa: curvas y estados individuales finales. Reiniciar vuelve a t=0."
end

to-report ultimo-indice
  report max (list 0 (length datos-java - 1) (length datos-referencia - 1))
end

to-report terminado?
  report indice >= ultimo-indice
end
